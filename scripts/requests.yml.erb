# Ractor safety request specs for this app.
#
# Each request is processed by Rails.application.call(env) inside a non-main
# Ractor. ERB is evaluated before YAML parsing so seed record IDs can be used.
#
# Keys:
#   method:  HTTP method (GET, POST, PATCH, DELETE, HEAD)
#   path:    Request path
#   expect:  Expected HTTP status code(s)
#   params:  Form-encoded body parameters (optional)
#   headers: Extra Rack env headers (optional)
#   query:   Query string (optional)
#   body_includes: String(s) that must appear in the response body (optional)

# --- Health check route generated by Rails ---
- method: GET
  path: /up
  expect: 200

# --- Posts: RESTful HTML routes ---
- method: GET
  path: /posts
  expect: 200
  body_includes:
    - Seed post body from Ractor test

- method: GET
  path: /posts/<%= seed_post_id %>
  expect: 200
  body_includes:
    - Seed post body from Ractor test

- method: GET
  path: /posts/new
  expect: 200

- method: GET
  path: /posts/<%= seed_post_id %>/edit
  expect: 200

- method: POST
  path: /posts
  expect: [302, 303]
  params:
    post[body]: Created in a request Ractor

- method: PATCH
  path: /posts/<%= seed_post_id %>
  expect: [302, 303]
  params:
    post[body]: Updated in a request Ractor

- method: DELETE
  path: /posts/<%= delete_post_id %>
  expect: [302, 303]

# --- Posts: RESTful JSON routes ---
- method: GET
  path: /posts.json
  expect: 200
  headers:
    HTTP_ACCEPT: application/json
  body_includes:
    - Updated in a request Ractor

- method: GET
  path: /posts/<%= seed_post_id %>.json
  expect: 200
  headers:
    HTTP_ACCEPT: application/json
  body_includes:
    - Updated in a request Ractor

- method: POST
  path: /posts.json
  expect: 201
  headers:
    HTTP_ACCEPT: application/json
  params:
    post[body]: JSON-created in a request Ractor

- method: PATCH
  path: /posts/<%= seed_post_id %>.json
  expect: 200
  headers:
    HTTP_ACCEPT: application/json
  params:
    post[body]: JSON-updated in a request Ractor

# --- HEAD requests for existing GET routes ---
- method: HEAD
  path: /posts
  expect: 200

- method: HEAD
  path: /posts/<%= seed_post_id %>
  expect: 200

# --- Query params on an existing route ---
- method: GET
  path: /posts
  expect: 200
  query: page=1&per_page=2
